                                            <Path Data="M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm2 4v8h2V8H8zm4 0v8h2V8h-2zm4 0v8h2V8h-2z" Fill="#8E9EAF" />
                                        </Viewbox>
                                        <TextBlock x:Name="TxtRamLabel" Text="Memorie RAM" Margin="6,0,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="RamValue" Text="-- / -- GB" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,2" />
                                    <Border Height="3" Background="#141E2B" CornerRadius="1.5">
                                        <Border x:Name="RamBar" Width="40" HorizontalAlignment="Left" Background="{StaticResource AccentCyan}" CornerRadius="1.5" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SEGMENT 4: GPU -->
                            <Border Grid.Column="3" BorderBrush="#192635" BorderThickness="1,0,0,0">
                                <StackPanel VerticalAlignment="Center" Margin="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-11 7H8v2H6v-2H4v-2h2V9h2v2h2v2zm4.5 1.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S17.67 8.5 18.5 8.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Fill="{StaticResource AccentGreen}" />
                                        </Viewbox>
                                        <TextBlock x:Name="GpuNameLabel" Text="GPU (RTX 4070)" Margin="6,0,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" ToolTip="NVIDIA GeForce RTX 4070 Laptop GPU" />
                                    </StackPanel>
                                    <TextBlock x:Name="GpuLoadValue" Text="0.0%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,2" />
                                    <Border Height="3" Background="#141E2B" CornerRadius="1.5">
                                        <Border x:Name="GpuBar" Width="16" HorizontalAlignment="Left" Background="{StaticResource AccentGreen}" CornerRadius="1.5" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- TOP RIGHT UTILITY & WINDOW CONTROLS -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                        <!-- Global Search Button -->
                        <Button x:Name="BtnGlobalSearch" Style="{StaticResource GlobalSearchHeaderButtonStyle}" Click="GlobalSearch_Click" ToolTip="Căutare Globală în toată aplicația (Ctrl+K)" VerticalAlignment="Center" Margin="0,1,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="#8E9EAF" />
                                </Viewbox>
                                <TextBlock x:Name="TxtGlobalSearch" Text="Caută..." Foreground="#8E9EAF" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#101826" BorderBrush="#1C2D42" BorderThickness="1" CornerRadius="3" Padding="4,1,4,1" Margin="6,0,0,0">
                                    <TextBlock Text="Ctrl+K" Foreground="#64748B" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Notifications & Updates Header Button (Icon-Only + Red Dot + Styled Tooltip) -->
                        <Button x:Name="BtnNotifications" Style="{StaticResource GlobalSearchHeaderButtonStyle}" Padding="8,0,8,0" MinWidth="28" Click="Notifications_Click" VerticalAlignment="Center" Margin="0,1,8,0">
                            <Button.ToolTip>
                                <ToolTip Background="#0D1624" BorderBrush="#263B54" BorderThickness="1" Padding="10,6,10,6" Placement="Bottom" VerticalOffset="6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="TooltipNotificationDot" Width="6" Height="6" CornerRadius="3" Background="#EF4444" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="TxtNotificationsTooltip" Text="Notificări și Actualizări" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0">
                                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" Fill="#8E9EAF" />
                                </Viewbox>
                                <Border x:Name="NotificationDot" Width="7" Height="7" CornerRadius="3.5" Background="#EF4444" BorderBrush="#0E1726" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <!-- Settings Header Button -->
                        <Button x:Name="BtnSettings" Style="{StaticResource GlobalSearchHeaderButtonStyle}" Click="Settings_Click" ToolTip="Setări și Limbă (Settings)" VerticalAlignment="Center" Margin="0,1,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Fill="#8E9EAF" />
                                </Viewbox>
                                <TextBlock x:Name="TxtTopSettings" Text="Setări" Foreground="#8E9EAF" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Custom Modern Window Chrome (Minimize, Maximize, Close) -->
                        <Button x:Name="BtnMinimize" Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click" ToolTip="Minimizare">
                            <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click" ToolTip="Maximizare">
                            <Path x:Name="MaximizeIconPath" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ChromeCloseButtonStyle}" Click="Close_Click" ToolTip="Închidere">
                            <Path Data="M 0,0 L 9.5,9.5 M 9.5,0 L 0,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT SCROLLER ================= -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource CanvasBg}">
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,8,14,16">
                    <StackPanel x:Name="PageRoot" MaxWidth="1540" HorizontalAlignment="Stretch" Margin="0,4,0,14" />
                </ScrollViewer>
            </Grid>

            <!-- ================= BOTTOM STATUS FOOTER ================= -->
            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource CanvasBg}" BorderBrush="#131B26" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <TextBlock x:Name="FooterMottoText" Text="Mai multă performanță. Fără compromisuri." Foreground="#566679" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#6E8299" Margin="0,0,0.8,0.8" />
                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#6E8299" Margin="0.8,0,0,0.8" />
                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#6E8299" Margin="0,0.8,0.8,0" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#6E8299" Margin="0.8,0.8,0,0" />
                        </Grid>
                        <TextBlock x:Name="FooterWindowsText" Text="Optimized for Windows 11" Foreground="#566679" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= LIVE TOAST NOTIFICATION (NON-INTRUSIVE) ================= -->
            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Panel.ZIndex="1500">
                <Border x:Name="ToastContainer" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,32" Width="400" Background="#111B27" BorderBrush="#22364B" BorderThickness="1" CornerRadius="10" Padding="0" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.7" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ToastAccentBar" Grid.Column="0" Background="{StaticResource AccentGreen}" CornerRadius="10,0,0,10" />
                        <Grid Grid.Column="1" Margin="14,12,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToastIconBox" Width="28" Height="28" CornerRadius="14" Background="#1E293B" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <ContentControl x:Name="ToastIconHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                <TextBlock x:Name="ToastTitle" Text="Optimizare în curs..." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ToastMessage" Text="Pregătire acțiuni..." FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,6" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="ToastProgressBar" Height="3" IsIndeterminate="True" Background="#1E293B" Foreground="#FF2A85" BorderThickness="0" Visibility="Collapsed" />
                                <Button x:Name="ToastReportBtn" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Foreground="#38BDF8" BorderBrush="#25476A" Visibility="Collapsed" Click="ToastReportBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="#38BDF8" />
                                        </Viewbox>
                                        <TextBlock Text="Vezi pașii aplicați" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" BorderThickness="0" Foreground="#8E9EAF" Content="×" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="ToastDismiss_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= MODAL OVERLAY ================= -->
            <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#C804070B" Visibility="Collapsed" Panel.ZIndex="2000" MouseDown="ModalOverlay_MouseDown">
                <Border x:Name="ModalBox" HorizontalAlignment="Center" VerticalAlignment="Center" Width="680" MaxHeight="720" Background="#0C1420" BorderBrush="#27384E" BorderThickness="1" CornerRadius="12" Padding="28,24" MouseDown="ModalBox_MouseDown">
                    <StackPanel x:Name="ModalContent" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexWin</AssemblyName>
    <RootNamespace>NexWin.Native</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\logo.ico</ApplicationIcon>
    <Version>1.0.87</Version>
    <FileVersion>1.0.87.0</FileVersion>
    <AssemblyVersion>1.0.87.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MainFormV2.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="assets\**" />
    <Content Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
</Project>
